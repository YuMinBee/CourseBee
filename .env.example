# CourseBee v3 optional API and local LLM settings
# Copy this file to .env or set the same variables in your shell.
# Do not commit real API keys.

OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Optional API boundary and local data controls.
# Leave COURSEBEE_API_KEY empty for the local browser demo.
COURSEBEE_API_KEY=
COURSEBEE_DATA_ROOT=outputs
COURSEBEE_ALLOW_LOCAL_PATHS=false
COURSEBEE_MAX_UPLOAD_BYTES=26214400
COURSEBEE_MAX_UPLOAD_BATCH_BYTES=104857600
COURSEBEE_MAX_UPLOAD_FILES=20
COURSEBEE_OCR_LANG=eng

# Optional local semantic retrieval and Cross-Encoder reranking.
COURSEBEE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
COURSEBEE_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
COURSEBEE_EMBEDDING_CACHE_SIZE=4096
COURSEBEE_INSTALL_SEMANTIC=false


# Retrieval for the default question path: lexical (Kiwi BM25, no extra install) or semantic
# (dense, needs COURSEBEE_INSTALL_SEMANTIC=true). The Korean RAG benchmark in docs/RAG_BENCHMARK.md
# recommends semantic with nlpai-lab/KURE-v1 as COURSEBEE_EMBEDDING_MODEL.
COURSEBEE_RETRIEVAL=lexical
# Rewrite answers whose key claim the retrieved sources do not support (on/off).
COURSEBEE_SUPPORT_CHECK=on
# Reference date for "currently effective" rules in prompts (YYYY-MM-DD). Empty means today.
COURSEBEE_TODAY=

# Optional local Ollama LLM settings for grounded answers and explicit general-knowledge fallback.
OLLAMA_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Reasoning ("thinking") for qwen3 and similar models. About 2.5x slower; it did not beat the default on the benchmark test split.
OLLAMA_THINK=false
